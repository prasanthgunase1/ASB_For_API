# Use Node.js base image
FROM node:18-alpine

# Set the working directory inside the container
WORKDIR /app

# Copy only package files first to install dependencies
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci --only=production


# Copy all project files into the container
COPY . .

# Set the command to run your agent worker
CMD ["node", "src/utils/agentWorker.js"]

# NOTE:
# Ensure worker and Redis are on the same Docker network
# See docker-compose.worker.example
