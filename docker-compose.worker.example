services:
  redis:
    image: redis:latest
    ports:
      - "6380:6379"
    networks:
      - app-network
  agentworker:
    build:
      context: .
      dockerfile: Dockerfile.worker
    environment:
      NODE_ENV: ${NODE_ENV}
      REDIS_URL: ${REDIS_URL}
    depends_on:
      - redis
    networks:
      - app-network

# Add this networks section back at the bottom
networks:
  app-network:
    driver: bridge