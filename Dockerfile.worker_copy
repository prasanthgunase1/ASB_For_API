# Use Node.js base image
FROM node:18-alpine

# Set the working directory inside the container
WORKDIR /app

# Copy only package files first to install dependencies
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci --only=production


# =====================================================
# -------- BUILD ARGUMENTS
# =====================================================

# --- APP / COMMON ---
ARG NODE_ENV
ARG BUILD_ID
ARG PORT
ARG DOMAIN_URL
ARG LOG_LEVEL
ARG MEDIA_API_ENDPOINT
ARG NODE_TLS_REJECT_UNAUTHORIZED
ARG FILE_SIZE_LIMIT
ARG DEFAULT_LIMIT
ARG DEFAULT_PAGE
ARG ALLOWED_FILE_TYPES
ARG ALLOWED_ORIGINS
ARG ALLOW_CREDENTIALS

# --- DATABASE ---
ARG DB_DIALECT
ARG DB_HOST
ARG DB_NAME
ARG DB_USER
ARG DB_PASSWORD

# --- REDIS ---
ARG REDIS_HOST
ARG REDIS_PORT
ARG REDIS_PASSWORD
ARG REDIS_SSL
ARG REDIS_EXPIRE

# --- AI / LLM ---
ARG LLM_ENDPOINT
ARG INSIGHTS_DATA_INDEX
ARG CHATAI_STATUS_COMPLETED
ARG CHATAI_STATUS_INPROGRESS

# --- POWER BI ---
ARG POWERBI_CLIENT_ID
ARG POWERBI_CLIENT_SECRET
ARG POWERBI_TENANT_ID
ARG POWERBI_DEFAULT_WORKSPACE_ID
ARG POWERBI_TOKEN_EXPIRY_MS
ARG POWERBI_API_TIMEOUT_MS
ARG POWERBI_DEMO_REPORT_REC_ID
ARG POWERBI_DEMO_REPORT_RETAIL_ID

# --- MICROSTRATEGY ---
ARG MICROSTRATEGY_BASE_URL
ARG MICROSTRATEGY_PROJECT_ID
ARG MICROSTRATEGY_DEFAULT_DASHBOARD_ID


# =====================================================
# --- KEYCLOAK (DISABLED – LEGACY) ---
# =====================================================
# ARG KEYCLOAK_URL
# ARG KEYCLOAK_REALM
# ARG KEYCLOAK_CLIENT_ID
# ARG KEYCLOAK_CLIENT_SECRET


# =====================================================
# --- OKTA CONFIGURATION ---
# =====================================================
ARG OKTA_ISSUER
ARG OKTA_CLIENT_ID
ARG OKTA_AUDIENCE


# =====================================================
# --- AWS CONFIGURATION ---
# =====================================================
ARG AWS_REGION
ARG AWS_S3_BUCKET
ARG AWS_ACCESS_KEY_ID
ARG AWS_SECRET_ACCESS_KEY


# =====================================================
# -------- ENV VARIABLES
# =====================================================

# --- APP ---
ENV NODE_ENV=$NODE_ENV
ENV BUILD_ID=$BUILD_ID
ENV PORT=$PORT
ENV DOMAIN_URL=$DOMAIN_URL
ENV LOG_LEVEL=$LOG_LEVEL
ENV MEDIA_API_ENDPOINT=$MEDIA_API_ENDPOINT
ENV NODE_TLS_REJECT_UNAUTHORIZED=$NODE_TLS_REJECT_UNAUTHORIZED
ENV FILE_SIZE_LIMIT=$FILE_SIZE_LIMIT
ENV DEFAULT_LIMIT=$DEFAULT_LIMIT
ENV DEFAULT_PAGE=$DEFAULT_PAGE
ENV ALLOWED_FILE_TYPES=$ALLOWED_FILE_TYPES
ENV ALLOWED_ORIGINS=$ALLOWED_ORIGINS
ENV ALLOW_CREDENTIALS=$ALLOW_CREDENTIALS

# --- DATABASE ---
ENV DB_DIALECT=$DB_DIALECT
ENV DB_HOST=$DB_HOST
ENV DB_NAME=$DB_NAME
ENV DB_USER=$DB_USER
ENV DB_PASSWORD=$DB_PASSWORD

# --- REDIS ---
ENV REDIS_HOST=$REDIS_HOST
ENV REDIS_PORT=$REDIS_PORT
ENV REDIS_PASSWORD=$REDIS_PASSWORD
ENV REDIS_SSL=$REDIS_SSL
ENV REDIS_EXPIRE=$REDIS_EXPIRE

# --- AI / LLM ---
ENV LLM_ENDPOINT=$LLM_ENDPOINT
ENV INSIGHTS_DATA_INDEX=$INSIGHTS_DATA_INDEX
ENV CHATAI_STATUS_COMPLETED=$CHATAI_STATUS_COMPLETED
ENV CHATAI_STATUS_INPROGRESS=$CHATAI_STATUS_INPROGRESS

# --- POWER BI ---
ENV POWERBI_CLIENT_ID=$POWERBI_CLIENT_ID
ENV POWERBI_CLIENT_SECRET=$POWERBI_CLIENT_SECRET
ENV POWERBI_TENANT_ID=$POWERBI_TENANT_ID
ENV POWERBI_DEFAULT_WORKSPACE_ID=$POWERBI_DEFAULT_WORKSPACE_ID
ENV POWERBI_TOKEN_EXPIRY_MS=$POWERBI_TOKEN_EXPIRY_MS
ENV POWERBI_API_TIMEOUT_MS=$POWERBI_API_TIMEOUT_MS
ENV POWERBI_DEMO_REPORT_REC_ID=$POWERBI_DEMO_REPORT_REC_ID
ENV POWERBI_DEMO_REPORT_RETAIL_ID=$POWERBI_DEMO_REPORT_RETAIL_ID

# --- MICROSTRATEGY ---
ENV MICROSTRATEGY_BASE_URL=$MICROSTRATEGY_BASE_URL
ENV MICROSTRATEGY_PROJECT_ID=$MICROSTRATEGY_PROJECT_ID
ENV MICROSTRATEGY_DEFAULT_DASHBOARD_ID=$MICROSTRATEGY_DEFAULT_DASHBOARD_ID


# =====================================================
# --- OKTA ENV ---
# =====================================================
ENV OKTA_ISSUER=$OKTA_ISSUER
ENV OKTA_CLIENT_ID=$OKTA_CLIENT_ID
ENV OKTA_AUDIENCE=$OKTA_AUDIENCE


# =====================================================
# --- AWS ENV ---
# =====================================================
ENV AWS_REGION=$AWS_REGION
ENV AWS_S3_BUCKET=$AWS_S3_BUCKET
ENV AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
ENV AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY


# =====================================================
# -------- APP STARTUP
# =====================================================

# Copy all project files into the container
COPY . .

# Set the command to run your agent worker
CMD ["node", "src/utils/agentWorker.js"]

# NOTE:
# Ensure worker and Redis are on the same Docker network
# See docker-compose.worker.example
